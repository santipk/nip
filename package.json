{
  "name": "nip-desktop",
  "productName": "NIP",
  "version": "0.1.0",
  "private": true,
  "description": "NIP — llamadas de amigos en servidores autohospedados",
  "main": "dist/main.cjs",
  "scripts": {
    "build": "node scripts/build.mjs",
    "start": "npm run build && electron .",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "test:e2e": "npm run build && tsx --test tests/desktop.e2e.ts",
    "package": "npm run build && electron-packager . NIP --platform=win32 --arch=x64 --out=release --overwrite --ignore=^/release --ignore=^/tests --ignore=^/test-results --ignore=^/work",
    "test:package": "tsx --test tests/package.smoke.ts"
  },
  "dependencies": {
    "selfsigned": "5.5.0",
    "ws": "8.23.0"
  },
  "devDependencies": {
    "@electron/packager": "20.3.0",
    "@types/node": "22.20.5",
    "@types/ws": "8.18.2",
    "electron": "45.3.2",
    "esbuild": "0.28.2",
    "playwright": "1.65.0",
    "tsx": "4.23.15",
    "typescript": "7.0.2"
  },
  "license": "MIT",
  "author": "Santiago Abregu",
  "repository": {
    "type": "git",
    "url": "https://github.com/santipk/nip.git"
  },
  "bugs": {
    "url": "https://github.com/santipk/nip/issues"
  },
  "homepage": "https://github.com/santipk/nip#readme"
}
